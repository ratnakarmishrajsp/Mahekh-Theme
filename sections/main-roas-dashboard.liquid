  "class": "section-roas-cockpit",
  "settings": [
    {
      "type": "text",
      "id": "cockpit_passcode",
      "label": "4-Digit Security Passcode",
      "default": "1409",
      "info": "Security PIN required to unlock this dashboard"
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Live Sync Engine API Endpoint",
      "default": "http://localhost:4040",
      "info": "Local engine or hosted API base URL"
    },
    {
      "type": "number",
      "id": "cogs_default",
      "label": "Default Product Cost (COGS) in INR",
      "default": 180
    },
    {
      "type": "number",
      "id": "shipping_default",
      "label": "Default Shipping Cost in INR",
      "default": 70
    },
    {
      "type": "number",
      "id": "rto_default",
      "label": "Default Expected RTO %",
      "default": 20
    }
  ]
}
{% endschema %}
