{% comment %}
  Mahekh Fragrances - Live Order Tracking Portal
  Real-Time Tracking Integrated with Shiprocket Logistics Database
{% endcomment %}

<div class="mh-track-wrapper page-width">
  <div class="mh-track-card">
    <div class="mh-track-header">
      <span class="mh-track-badge">👑 Mahekh Express Tracking</span>
      <h1 class="mh-track-title">{{ section.settings.title | default: 'Track Your Order' }}</h1>
      <p class="mh-track-subtitle">
        {{ section.settings.subtitle | default: 'Enter your Order Number (e.g. #MA2014 or 2014), Mobile Number, or AWB to view real-time shipment status.' }}
      </p>
    </div>

    <form id="MhTrackForm" class="mh-track-form" onsubmit="handleOrderTrack(event)">
      <div class="mh-track-input-group">
        <input
          type="text"
          id="MhTrackInput"
          class="mh-track-input"
          placeholder="e.g. 2014, #MA2014, or 9565179040"
          required
          autocomplete="off"
        />
        <button type="submit" id="MhTrackSubmitBtn" class="mh-track-btn">
          TRACK ORDER
        </button>
      </div>
      <p class="mh-track-hint">Enter your Order ID (from SMS/WhatsApp), registered 10-digit phone, or AWB tracking code.</p>
    </form>

    <!-- Loading Spinner -->
    <div id="MhTrackLoading" class="mh-track-loading" style="display: none;">
      <div class="mh-track-spinner"></div>
      <p>Searching Shiprocket logistics records...</p>
    </div>

    <!-- Error Alert Box -->
    <div id="MhTrackError" class="mh-track-error-box" style="display: none;">
      <div class="mh-error-icon">⚠️</div>
      <div class="mh-error-content">
        <h4 id="MhErrorTitle">Order Not Found</h4>
        <p id="MhErrorMsg">We could not find an active order matching your input. Please verify the order number from your SMS or WhatsApp confirmation.</p>
        <div id="MhErrorFallbackAction" style="margin-top: 10px; display: none;">
          <a id="MhAwbFallbackBtn" href="#" target="_blank" rel="noopener" class="mh-track-external-btn" style="padding: 6px 14px; font-size: 1rem;">
            Check Directly on Shiprocket Portal ↗
          </a>
        </div>
      </div>
    </div>

    <!-- Real Live Tracking Result Container -->
    <div id="MhTrackResult" class="mh-track-result" style="display: none;">
      <div class="mh-result-header">
        <div>
          <div class="mh-order-id-label">Tracking Order</div>
          <div class="mh-order-id-val" id="ResOrderId">#MA2014</div>
          <div class="mh-order-date" id="ResOrderDate" style="font-size: 0.9rem; color: #8c857b; margin-top: 2px;">Order Date: -</div>
        </div>
        <div class="mh-status-pill" id="ResStatusPill">In Transit</div>
      </div>

      <!-- 5-Step Visual Timeline -->
      <div class="mh-timeline-wrapper">
        <div class="mh-timeline-step" id="Step1">
          <div class="mh-step-circle">1</div>
          <div class="mh-step-label">Order Confirmed</div>
          <div class="mh-step-desc">Received</div>
        </div>
        <div class="mh-timeline-step" id="Step2">
          <div class="mh-step-circle">2</div>
          <div class="mh-step-label">Packed &amp; Prepared</div>
          <div class="mh-step-desc" id="Step2Desc">Quality checked</div>
        </div>
        <div class="mh-timeline-step" id="Step3">
          <div class="mh-step-circle">3</div>
          <div class="mh-step-label">Shipped / In Transit</div>
          <div class="mh-step-desc" id="Step3Desc">With courier</div>
        </div>
        <div class="mh-timeline-step" id="Step4">
          <div class="mh-step-circle">4</div>
          <div class="mh-step-label">Out for Delivery</div>
          <div class="mh-step-desc" id="Step4Desc">Pending</div>
        </div>
        <div class="mh-timeline-step" id="Step5">
          <div class="mh-step-circle">5</div>
          <div class="mh-step-label">Delivered</div>
          <div class="mh-step-desc" id="Step5Desc">Pending</div>
        </div>
      </div>

      <!-- Real Courier Details Strip -->
      <div class="mh-courier-strip">
        <div class="mh-courier-col">
          <span class="mh-col-label">Courier Partner</span>
          <span class="mh-col-val" id="ResCourierName">Delhivery Surface</span>
        </div>
        <div class="mh-courier-col">
          <span class="mh-col-label">AWB Tracking Code</span>
          <span class="mh-col-val" id="ResAwbCode" style="font-family: monospace; font-size: 1.15rem; color: #cca43b; font-weight: 700;">-</span>
        </div>
        <div class="mh-courier-col">
          <span class="mh-col-label">Destination</span>
          <span class="mh-col-val" id="ResDestination">India</span>
        </div>
        <div class="mh-courier-col">
          <span class="mh-col-label">Shipping Rate</span>
          <span class="mh-col-val" style="color: #10b981; font-weight: 700;">100% Free Express</span>
        </div>
      </div>

      <!-- Real Live Shiprocket Link -->
      <div style="text-align: center; margin-top: 1.8rem;" id="ResShiprocketLinkWrapper">
        <a id="ResShiprocketLink" href="#" target="_blank" rel="noopener" class="mh-track-external-btn">
          Open Official Shiprocket Real-Time Tracking ↗
        </a>
      </div>
    </div>

    <!-- Help / WhatsApp Strip -->
    <div class="mh-track-help">
      <span>Need instant personal help with your parcel?</span>
      <a href="https://wa.me/919565179040?text=Hi%20Mahekh,%20I%20need%20help%20tracking%20my%20order" target="_blank" rel="noopener" class="mh-whatsapp-link">
        💬 Chat with Support on WhatsApp
      </a>
    </div>
  </div>
</div>

<style>
