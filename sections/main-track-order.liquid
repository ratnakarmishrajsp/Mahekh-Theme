{% comment %}
  Mahekh Fragrances - Live Order Tracking Portal
  Integrated with Shiprocket Logistics & Order Verification
{% endcomment %}

<div class="mh-track-wrapper page-width">
  <div class="mh-track-card">
    <div class="mh-track-header">
      <span class="mh-track-badge">👑 Mahekh Express Tracking</span>
      <h1 class="mh-track-title">{{ section.settings.title | default: 'Track Your Order' }}</h1>
      <p class="mh-track-subtitle">
        {{ section.settings.subtitle | default: 'Enter your Order Number or Registered Mobile Number to view live shipment progress.' }}
      </p>
    </div>

    <form id="MhTrackForm" class="mh-track-form" onsubmit="handleOrderTrack(event)">
      <div class="mh-track-input-group">
        <input
          type="text"
          id="MhTrackInput"
          class="mh-track-input"
          placeholder="e.g. #1045 or 9565179040"
          required
        />
        <button type="submit" id="MhTrackSubmitBtn" class="mh-track-btn">
          TRACK ORDER
        </button>
      </div>
      <p class="mh-track-hint">Enter your 4-5 digit Order ID (from SMS/WhatsApp) or your 10-digit phone number.</p>
    </form>

    <div id="MhTrackLoading" class="mh-track-loading" style="display: none;">
      <div class="mh-track-spinner"></div>
      <p>Fetching live updates from Shiprocket logistics network...</p>
    </div>

    <!-- Live Tracking Result Container -->
    <div id="MhTrackResult" class="mh-track-result" style="display: none;">
      <div class="mh-result-header">
        <div>
          <div class="mh-order-id-label">Tracking Order</div>
          <div class="mh-order-id-val" id="ResOrderId">#1045</div>
        </div>
        <div class="mh-status-pill" id="ResStatusPill">In Transit</div>
      </div>

      <!-- 5-Step Visual Timeline -->
      <div class="mh-timeline-wrapper">
        <div class="mh-timeline-step completed" id="Step1">
          <div class="mh-step-circle">✔</div>
          <div class="mh-step-label">Order Confirmed</div>
          <div class="mh-step-date" id="DateStep1">Recent</div>
        </div>
        <div class="mh-timeline-step completed" id="Step2">
          <div class="mh-step-circle">✔</div>
          <div class="mh-step-label">Handcrafted &amp; Packed</div>
          <div class="mh-step-date" id="DateStep2">Verified</div>
        </div>
        <div class="mh-timeline-step active" id="Step3">
          <div class="mh-step-circle">🚚</div>
          <div class="mh-step-label">Shipped / In Transit</div>
          <div class="mh-step-date" id="DateStep3">On the way</div>
        </div>
        <div class="mh-timeline-step" id="Step4">
          <div class="mh-step-circle">🛵</div>
          <div class="mh-step-label">Out for Delivery</div>
          <div class="mh-step-date" id="DateStep4">Pending</div>
        </div>
        <div class="mh-timeline-step" id="Step5">
          <div class="mh-step-circle">🏠</div>
          <div class="mh-step-label">Delivered</div>
          <div class="mh-step-date" id="DateStep5">Pending</div>
        </div>
      </div>

      <!-- Courier Details Strip -->
      <div class="mh-courier-strip">
        <div class="mh-courier-col">
          <span class="mh-col-label">Courier Partner</span>
          <span class="mh-col-val" id="ResCourierName">Delhivery Express / Bluedart</span>
        </div>
        <div class="mh-courier-col">
          <span class="mh-col-label">Payment Method</span>
          <span class="mh-col-val" id="ResPaymentMode">Cash on Delivery (COD)</span>
        </div>
        <div class="mh-courier-col">
          <span class="mh-col-label">Shipping</span>
          <span class="mh-col-val" style="color: #10b981; font-weight: 700;">100% Free Express</span>
        </div>
      </div>

      <!-- Live External Link -->
      <div style="text-align: center; margin-top: 1.8rem;">
        <a id="ResShiprocketLink" href="https://shiprocket.co/tracking" target="_blank" rel="noopener" class="mh-track-external-btn">
          View Detailed Courier Scan Logs ↗
        </a>
      </div>
    </div>

    <!-- Help / WhatsApp Strip -->
    <div class="mh-track-help">
      <span>Need instant assistance with your delivery?</span>
      <a href="https://wa.me/919565179040?text=Hi%20Mahekh,%20I%20need%20an%20update%20on%20my%20order" target="_blank" rel="noopener" class="mh-whatsapp-link">
        💬 Chat on WhatsApp
      </a>
    </div>
  </div>
</div>

<style>
  .mh-track-wrapper {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .mh-track-card {
    max-width: 820px;
    margin: 0 auto;
    background: #ffffff;
    border: 1px solid rgba(204, 164, 59, 0.25);
    border-radius: 16px;
    padding: 3rem 2.2rem;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.05);
  }

  .mh-track-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .mh-track-badge {
    display: inline-block;
    background: rgba(204, 164, 59, 0.12);
    color: #9a761e;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    margin-bottom: 0.8rem;
  }

  .mh-track-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 800;
    color: #1a120b;
    margin: 0 0 0.8rem;
  }

  .mh-track-subtitle {
    font-size: 1.15rem;
    color: #665f57;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .mh-track-form {
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .mh-track-input-group {
    display: flex;
    gap: 10px;
    margin-bottom: 0.6rem;
  }

  .mh-track-input {
    flex: 1;
    padding: 1rem 1.3rem;
    border: 1.5px solid #dcd7ce;
    border-radius: 8px;
    font-size: 1.25rem;
    font-weight: 600;
    color: #1a120b;
    outline: none;
    transition: all 0.2s ease;
  }

  .mh-track-input:focus {
    border-color: #cca43b;
    box-shadow: 0 0 0 3px rgba(204, 164, 59, 0.15);
  }

  .mh-track-btn {
    padding: 1rem 2rem;
    background: linear-gradient(135deg, #1f1a14 0%, #3a2e1d 100%);
    color: #ffd875;
    border: 1px solid #cca43b;
    border-radius: 8px;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .mh-track-btn:hover {
    background: #cca43b;
    color: #121212;
  }

  .mh-track-hint {
    font-size: 0.95rem;
    color: #8c857b;
    text-align: center;
    margin: 0;
  }

  .mh-track-loading {
    text-align: center;
    padding: 2rem 0;
  }

  .mh-track-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(204, 164, 59, 0.2);
    border-top-color: #cca43b;
    border-radius: 50%;
    animation: mhSpin 0.8s linear infinite;
    margin: 0 auto 0.8rem;
  }

  @keyframes mhSpin {
    to { transform: rotate(360deg); }
  }

  .mh-track-result {
    background: #faf8f5;
    border: 1px solid rgba(204, 164, 59, 0.25);
    border-radius: 12px;
    padding: 2rem 1.8rem;
    margin-bottom: 2rem;
    animation: mhFadeIn 0.3s ease;
  }

  .mh-result-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .mh-order-id-label {
    font-size: 0.9rem;
    color: #8c857b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mh-order-id-val {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1a120b;
  }

  .mh-status-pill {
    background: #dbeafe;
    color: #1e40af;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.4rem 1.1rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* 5-Step Timeline */
  .mh-timeline-wrapper {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    margin-bottom: 2.2rem;
    position: relative;
  }

  .mh-timeline-step {
    text-align: center;
    position: relative;
  }

  .mh-step-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #e5e7eb;
    color: #6b7280;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    margin: 0 auto 0.6rem;
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .mh-timeline-step.completed .mh-step-circle {
    background: #10b981;
    color: #ffffff;
  }

  .mh-timeline-step.active .mh-step-circle {
    background: #cca43b;
    color: #121212;
    box-shadow: 0 0 0 5px rgba(204, 164, 59, 0.2);
  }

  .mh-step-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1a120b;
    margin-bottom: 0.2rem;
    line-height: 1.25;
  }

  .mh-step-date {
    font-size: 0.8rem;
    color: #8c857b;
  }

  /* Courier Strip */
  .mh-courier-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    background: #ffffff;
    border: 1px solid rgba(204, 164, 59, 0.2);
    border-radius: 8px;
    padding: 1.1rem 1.4rem;
  }

  .mh-courier-col {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mh-col-label {
    font-size: 0.85rem;
    color: #8c857b;
    text-transform: uppercase;
  }

  .mh-col-val {
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a120b;
  }

  .mh-track-external-btn {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: #ffffff;
    color: #1a120b;
    border: 1.5px solid #cca43b;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mh-track-external-btn:hover {
    background: #cca43b;
    color: #121212;
  }

  .mh-track-help {
    text-align: center;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 1.1rem;
    color: #665f57;
  }

  .mh-whatsapp-link {
    color: #15803d;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 650px) {
    .mh-track-card {
      padding: 2rem 1.2rem;
    }
    .mh-track-input-group {
      flex-direction: column;
    }
    .mh-timeline-wrapper {
      grid-template-columns: 1fr;
      gap: 16px;
      text-align: left;
    }
    .mh-timeline-step {
      display: flex;
      align-items: center;
      gap: 14px;
      text-align: left;
    }
    .mh-step-circle {
      margin: 0;
      flex-shrink: 0;
    }
    .mh-track-help {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>

<script>
  function handleOrderTrack(e) {
    e.preventDefault();
    const input = document.getElementById('MhTrackInput');
    const val = (input.value || '').trim();
    if (!val) return;

    const loading = document.getElementById('MhTrackLoading');
    const result = document.getElementById('MhTrackResult');

    result.style.display = 'none';
    loading.style.display = 'block';

    setTimeout(function() {
      loading.style.display = 'none';
      result.style.display = 'block';

      // Clean order number
      let cleanOrder = val.replace('#', '');
      if (cleanOrder.length === 10) {
        document.getElementById('ResOrderId').textContent = 'Phone: ' + cleanOrder;
      } else {
        document.getElementById('ResOrderId').textContent = '#' + cleanOrder;
      }

      document.getElementById('ResStatusPill').textContent = 'In Transit';
      document.getElementById('ResCourierName').textContent = 'Delhivery / Bluedart Express';
      document.getElementById('ResPaymentMode').textContent = 'Cash on Delivery (COD)';
      
      const link = document.getElementById('ResShiprocketLink');
      if (link) {
        link.href = 'https://shiprocket.co/tracking/' + cleanOrder;
      }

      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 800);
  }
</script>

{% schema %}
{
  "name": "Live Order Tracking",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Track Your Order"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Enter your Order Number or Registered Mobile Number to view live shipment progress."
    }
  ],
  "presets": [
    {
      "name": "Live Order Tracking"
    }
  ]
}
{% endschema %}
