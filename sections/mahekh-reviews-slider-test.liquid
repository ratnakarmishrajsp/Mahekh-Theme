{%- comment -%}
  Mahekh reviews slider (Claude, 28 Nov 2026; owner: "revies slider dalo").
  Shows ONLY real customer reviews stored in the product metafield mahekh.reviews (type json), e.g.
  [{"name":"Priya","city":"Pune","rating":5,"text":"...","pack":"Pack of 1","verified":true,"order":"#MA1555","date":"2026-12-01","source":"WhatsApp"}]
  "verified": true only when the review is matched to a real order ("order" is kept for checking and is never printed).
  With no reviews the section renders nothing.
{%- endcomment -%}
{%- liquid
  assign reviews = product.metafields.mahekh_test.reviews.value
  assign n = 0
  if reviews
    assign n = reviews.size
  endif
-%}
{%- if n > 0 -%}
{%- liquid
  assign total = 0
  for r in reviews
    assign total = total | plus: r.rating
  endfor
  assign avg10 = total | times: 10 | divided_by: n
  assign avg_whole = avg10 | divided_by: 10
  assign avg_dec = avg10 | modulo: 10
  assign avg_round = avg10 | plus: 5 | divided_by: 10
-%}
<div class="page-width">
<section class="mh-rv" id="mh-reviews-{{ section.id }}" aria-label="Customer reviews">
<style>
.mh-rv{--gold:#c79a46;--ink:#2a1712;--muted:#67524a;--line:#e9d7bf;--plum:#4d1631;margin:0 0 48px;background:#fcf6ec;border:1px solid var(--line);padding:56px 0 50px;font-family:'Mukta','Noto Sans Devanagari','Nirmala UI',Arial,sans-serif;color:var(--ink);text-align:left}
.mh-rv *{box-sizing:border-box}.mh-rv-in{padding:0 44px}
.mh-rv .mh-rv-k{color:#a8405a;font-weight:600;font-size:14px;text-align:center;margin:0 0 10px}.mh-rv .mh-rv-k span{font-family:'Tiro Devanagari Hindi',Georgia,serif;font-weight:400}
.mh-rv h2{font-family:'Tiro Devanagari Hindi',Georgia,serif;font-weight:400;font-size:38px;line-height:1.3;text-align:center;color:var(--ink);margin:0;text-transform:none;letter-spacing:0}
.mh-rv .mh-rv-sum{text-align:center;color:var(--muted);margin:10px 0 0;font-size:16px}.mh-rv .mh-rv-sum b{color:var(--ink)}
.mh-rv .st{color:var(--gold);letter-spacing:2px}.mh-rv .st .off{color:#e3d3bd}
.mh-rv-track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 40px)/3);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;margin-top:32px;padding:2px 2px 8px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.mh-rv-track::-webkit-scrollbar{display:none}.mh-rv-track:focus-visible{outline:3px solid var(--gold);outline-offset:4px}
.mh-rv-card{scroll-snap-align:start;margin:0;background:#fffbf5;border:1px solid var(--line);border-top:3px solid var(--gold);padding:26px 24px 22px;display:flex;flex-direction:column;gap:14px}
.mh-rv-card .st{font-size:18px}
.mh-rv-card blockquote{margin:0;padding:0;border:0;font-size:16px;line-height:1.75;color:#3d2a22;flex:1;font-style:normal;quotes:none}
.mh-rv-card figcaption{font-size:14.5px;color:var(--muted);line-height:1.5}.mh-rv-card figcaption b{color:var(--ink);font-weight:600}
.mh-rv-card .v{display:block;color:#2f7a45;font-size:13px;margin-top:3px}
.mh-rv-nav{display:flex;justify-content:center;gap:12px;margin-top:22px}
.mh-rv-nav button{width:44px;height:44px;border-radius:50%;border:1px solid var(--gold);background:#fff;color:var(--plum);font-size:22px;line-height:1;cursor:pointer;padding:0}
.mh-rv-nav button:hover{background:#fff4e0}.mh-rv-nav button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
@media(max-width:900px){.mh-rv-track{grid-auto-columns:calc((100% - 20px)/2)}}
@media(max-width:749px){.mh-rv{padding:44px 0 38px;margin-bottom:26px}.mh-rv-in{padding:0 18px}.mh-rv h2{font-size:30px}.mh-rv-track{grid-auto-columns:86%;gap:14px}}
</style>
<div class="mh-rv-in">
<p class="mh-rv-k"><span lang="hi">ग्राहकों की राय</span> · Customer reviews</p>
<h2>What our customers say</h2>
<p class="mh-rv-sum"><span class="st" aria-hidden="true">{% for i in (1..5) %}<span{% if i > avg_round %} class="off"{% endif %}>★</span>{% endfor %}</span> <b>{{ avg_whole }}.{{ avg_dec }}</b> out of 5 · {{ n }} {% if n == 1 %}review{% else %}reviews{% endif %}</p>
<div class="mh-rv-track" tabindex="0" role="region" aria-label="Customer reviews, scroll sideways">
{%- for r in reviews -%}
<figure class="mh-rv-card">
<div class="st" role="img" aria-label="{{ r.rating }} out of 5 stars">{% for i in (1..5) %}<span{% if i > r.rating %} class="off"{% endif %}>★</span>{% endfor %}</div>
<blockquote>“{{ r.text | escape }}”</blockquote>
<figcaption><b>{{ r.name | escape }}</b>{% if r.city != blank %}, {{ r.city | escape }}{% endif %}{% if r.verified == true %}<span class="v">✔ Verified buyer{% if r.pack != blank %} · {{ r.pack | escape }}{% endif %}</span>{% endif %}</figcaption>
</figure>
{%- endfor -%}
</div>
{%- if n > 1 -%}
<div class="mh-rv-nav"><button type="button" data-dir="-1" aria-label="Previous reviews">‹</button><button type="button" data-dir="1" aria-label="Next reviews">›</button></div>
{%- endif -%}
</div>
<script>
(function(){var s=document.getElementById('mh-reviews-{{ section.id }}');if(!s)return;var t=s.querySelector('.mh-rv-track');
s.querySelectorAll('[data-dir]').forEach(function(b){b.addEventListener('click',function(){var c=t.querySelector('.mh-rv-card');var w=c?c.getBoundingClientRect().width+20:300;t.scrollBy({left:w*Number(b.getAttribute('data-dir')),behavior:'smooth'});});});})();
</script>
</section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Mahekh reviews slider",
  "settings": [],
  "presets": [{"name": "Mahekh reviews slider"}]
}
{% endschema %}
