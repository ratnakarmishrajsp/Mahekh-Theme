<script>
  let ciDatabase = null;
  let currentActiveCustomer = null;

  async function loadCustomerDatabase() {
    if (ciDatabase) return ciDatabase;
    try {
      const res = await fetch("{{ 'mahekh-customer-index.json' | asset_url }}");
      if (res.ok) {
        ciDatabase = await res.json();
        return ciDatabase;
      }
    } catch(err) {
      console.warn('[CI] Failed to load customer index:', err);
    }
    return [];
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadCustomerDatabase();

    const input = document.getElementById('CiSearchInput');
    const clearBtn = document.getElementById('CiClearInputBtn');
    if (input && clearBtn) {
      input.addEventListener('input', () => {
        clearBtn.style.display = input.value.trim() ? 'flex' : 'none';
      });
    }

    // Auto-search query param if provided (e.g. ?q=9565179040)
    const urlParams = new URLSearchParams(window.location.search);
    const qParam = urlParams.get('q') || urlParams.get('search');
    if (qParam) {
      quickSearch(qParam);
    }
  });

  function clearSearchInput() {
    const input = document.getElementById('CiSearchInput');
    input.value = '';
    document.getElementById('CiClearInputBtn').style.display = 'none';
    input.focus();
  }

  function quickSearch(val) {
    const input = document.getElementById('CiSearchInput');
    input.value = val;
    document.getElementById('CiClearInputBtn').style.display = 'flex';
    handleCiSearch(new Event('submit'));
  }

  async function handleCiSearch(e) {
    if (e && e.preventDefault) e.preventDefault();
    const input = document.getElementById('CiSearchInput');
    const raw = (input.value || '').trim();
    if (!raw) return;

    const loading = document.getElementById('CiLoading');
    const errorBox = document.getElementById('CiError');
    const resultBox = document.getElementById('CiResult');

    resultBox.style.display = 'none';
    errorBox.style.display = 'none';
    loading.style.display = 'block';

    const db = await loadCustomerDatabase();
    loading.style.display = 'none';

    const qDigits = raw.replace(/\D/g, '');
    const qClean = raw.replace(/[#\s]/g, '').toLowerCase();

    let match = null;

    if (Array.isArray(db) && db.length > 0) {
      // 1. Check Phone Match (last 10 digits)
      if (qDigits.length >= 10) {
        const last10 = qDigits.slice(-10);
        match = db.find(c => c.phone && c.phone.endsWith(last10));
      }

      // 2. Check Order Number Match (e.g. 1977 or MA1977)
      if (!match && qDigits.length > 0) {
        match = db.find(c => c.orders && c.orders.some(o => o.num === qDigits || (o.name && o.name.toLowerCase().includes(qClean))));
      }

      // 3. Check Customer Name Match
      if (!match && qClean.length >= 3) {
        match = db.find(c => c.name && c.name.toLowerCase().includes(qClean));
      }
    }

    if (match) {
      currentActiveCustomer = match;
      renderCustomerProfile(match);
    } else {
      errorBox.style.display = 'flex';
      document.getElementById('CiErrorTitle').textContent = 'No Customer Profile Located';
      document.getElementById('CiErrorMsg').innerHTML = `No order history or customer matches <strong>"${escapeHtml(raw)}"</strong> in the current intelligence database. Verify the mobile number or order ID.`;
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function renderCustomerProfile(c) {
    const resultBox = document.getElementById('CiResult');

    // Clean name (strip trailing dots/punctuation like "Ratnakar .")
    let cleanName = (c.name || 'Customer').trim().replace(/[.\s]+$/, '');
    if (!cleanName) cleanName = 'Customer';

    // Customer Initials Avatar
    const avatar = document.getElementById('CiCustAvatar');
    const initials = cleanName.split(' ').filter(Boolean).map(n => n[0]).join('').slice(0, 2).toUpperCase() || 'C';
    avatar.textContent = initials;

    // Name & Location
    document.getElementById('CiCustName').textContent = cleanName;
    document.getElementById('CiCustPhone').textContent = c.phone ? ('+91 ' + c.phone) : 'No Phone on Record';
    document.getElementById('CiCustLocation').textContent = (c.city || 'India') + (c.pincode ? (' - ' + c.pincode) : '');

    // Trust Badge
    const trustBadge = document.getElementById('CiTrustBadge');
    const trustText = document.getElementById('CiTrustBadgeText');
    trustText.textContent = c.trustBadge;
    trustBadge.className = 'ci-badge-pill ' + (c.trustColor || 'green');

    // Multi-location badge
    const multiLoc = document.getElementById('CiMultiLocBadge');
    multiLoc.style.display = c.isMultiLocation ? 'inline-block' : 'none';

    // Quick Action Links
    const callBtn = document.getElementById('CiCallBtn');
    const waBtn = document.getElementById('CiWaBtn');
    if (c.phone) {
      callBtn.href = 'tel:+91' + c.phone;
      callBtn.style.display = 'inline-flex';
      waBtn.href = 'https://wa.me/91' + c.phone;
      waBtn.style.display = 'inline-flex';
    } else {
      callBtn.style.display = 'none';
      waBtn.style.display = 'none';
    }

    // Lifetime Metrics Numbers (Large, Prominent)
    document.getElementById('CiTotalOrders').textContent = c.totalOrders || 1;
    document.getElementById('CiDeliveredOrders').textContent = c.deliveredOrders || 0;
    document.getElementById('CiRtoOrders').textContent = c.rtoOrders || 0;
    document.getElementById('CiCancelledOrders').textContent = c.cancelledOrders || 0;
    document.getElementById('CiTotalSpent').textContent = '₹' + Number(c.totalSpent || 0).toLocaleString('en-IN');
    
    document.getElementById('CiOrderMixSub').textContent = `${c.totalOrders || 1} Lifetime Inquiries`;
    document.getElementById('CiRtoSub').textContent = `${c.rtoOrders || 0} Courier Returns`;
    document.getElementById('CiAovSub').textContent = `AOV: ₹${Number(c.aov || 0).toLocaleString('en-IN')} per order`;

    // Dispatched success rate: Delivered / (Delivered + RTO) if any dispatched
    const dispatched = (c.deliveredOrders || 0) + (c.rtoOrders || 0);
    const dispatchRate = dispatched > 0 ? Math.round(((c.deliveredOrders || 0) / dispatched) * 100) : 100;
    document.getElementById('CiDeliveryRate').textContent = dispatchRate + '%';
    document.getElementById('CiCodRatio').textContent = `${dispatchRate}% Dispatched Acceptance`;

    // Active / Latest Order
    const latest = (c.orders && c.orders[0]) || {};
    document.getElementById('CiLatestOrderName').textContent = latest.name || ('#MA' + latest.num);
    document.getElementById('CiLatestOrderDate').textContent = latest.date || 'Recent';
    document.getElementById('CiLatestOrderAmt').textContent = '₹' + (latest.amount || 0) + ' · ' + (latest.payment_mode || 'COD');
    document.getElementById('CiLatestCourier').textContent = latest.courier || 'Pending Allocation';
    document.getElementById('CiLatestAwb').textContent = latest.awb || 'Not Assigned';
    document.getElementById('CiLatestItems').textContent = latest.items || 'Mahekh Fragrance Item';

    // Latest status pill
    const statusPill = document.getElementById('CiLatestStatusPill');
    const sUpper = String(latest.status || '').toUpperCase();
    statusPill.textContent = latest.status || 'CONFIRMED';
    
    if (sUpper.includes('DELIVERED')) {
      statusPill.className = 'ci-status-badge green';
    } else if (sUpper.includes('RTO')) {
      statusPill.className = 'ci-status-badge red';
    } else if (latest.isCancelled) {
      statusPill.className = 'ci-status-badge slate';
      statusPill.textContent = 'CANCELLED (Pre-Dispatch)';
    } else {
      statusPill.className = 'ci-status-badge amber';
    }

    // NDR Banner
    const ndrBanner = document.getElementById('CiNdrBanner');
    if (latest.ndr) {
      ndrBanner.style.display = 'flex';
      document.getElementById('CiNdrText').textContent = latest.ndr;
    } else {
      ndrBanner.style.display = 'none';
    }

    // Live Shiprocket Tracking Link
    const trackWrap = document.getElementById('CiLiveTrackBtnWrapper');
    const trackBtn = document.getElementById('CiLiveTrackBtn');
    if (latest.awb) {
      trackWrap.style.display = 'block';
      trackBtn.href = 'https://shiprocket.co/tracking/' + latest.awb;
      trackBtn.querySelector('span').textContent = 'Open Real-Time Courier Tracking Dossier (' + latest.awb + ')';
    } else {
      trackWrap.style.display = 'none';
    }

    // Address & Quality Panel
    document.getElementById('CiAddrStatus').textContent = c.addressQuality || '🟢 Complete Address';
    document.getElementById('CiPincodeBadge').textContent = 'PIN: ' + (c.pincode || 'N/A');
    document.getElementById('CiFullAddr').textContent = (c.city || 'India') + (c.pincode ? (' - Pincode: ' + c.pincode) : '') + (c.city ? ` (City: ${c.city})` : '');

    // Recommendation Verdict
    const verdictBox = document.getElementById('CiVerdictBox');
    const verdictTag = document.getElementById('CiVerdictTag');
    const riskTxt = document.getElementById('CiRiskAssessmentText');
    const dispTxt = document.getElementById('CiDispatchRecText');

    if (c.rtoOrders > 0) {
      verdictBox.className = 'ci-verdict-box red';
      verdictTag.textContent = '⚠️ HIGH RTO RETURN RISK';
      riskTxt.textContent = `Customer has ${c.rtoOrders} previous parcel(s) returned by courier. Verification call mandatory before creating shipment.`;
      dispTxt.textContent = 'Confirm full address landmark, phone availability on delivery day, and payment readiness.';
    } else if (c.deliveredOrders >= 2) {
      verdictBox.className = 'ci-verdict-box';
      verdictTag.textContent = '👑 VIP CUSTOMER · IMMEDIATE DISPATCH';
      riskTxt.textContent = `Customer has successfully received ${c.deliveredOrders} orders with ZERO courier returns (100% acceptance rate). Highly trusted buyer.`;
      dispTxt.textContent = 'Safe to dispatch immediately without delay. Treat as priority customer.';
    } else if (c.deliveredOrders === 1) {
      verdictBox.className = 'ci-verdict-box';
      verdictTag.textContent = '🟢 VERIFIED BUYER · SAFE TO DISPATCH';
      riskTxt.textContent = 'Customer has 1 verified delivery on record with zero courier returns. Clean track record.';
      dispTxt.textContent = 'Safe to dispatch via regular express courier.';
    } else if (c.cancelledOrders > 0 && c.deliveredOrders === 0) {
      verdictBox.className = 'ci-verdict-box';
      verdictTag.textContent = '⚪ PRE-DISPATCH INQUIRIES ON RECORD';
      riskTxt.textContent = `Customer previously cancelled ${c.cancelledOrders} order(s) before shipping (no freight loss). Phone call recommended to confirm order intent.`;
      dispTxt.textContent = 'Verify that the customer intends to receive the order before packing.';
    } else {
      verdictBox.className = 'ci-verdict-box';
      verdictTag.textContent = '🟡 NEW BUYER (1ST ORDER)';
      riskTxt.textContent = 'First-time customer with no previous courier history. Standard confirmation procedure recommended.';
      dispTxt.textContent = 'Confirm house number, road name, and recipient availability.';
    }

    // Chronological History Timeline
    const list = document.getElementById('CiHistoryList');
    const countBadge = document.getElementById('CiHistoryCountBadge');
    list.innerHTML = '';
    
    if (c.orders && c.orders.length > 0) {
      countBadge.textContent = `${c.orders.length} Historical Records`;
      c.orders.forEach(ord => {
        const div = document.createElement('div');
        const isDeliv = ord.isDelivered;
        const isRto = ord.isRto;
        const isCanc = ord.isCancelled;
        const isInTrans = ord.isInTransit;

        let rowType = 'pending';
        let pillClass = 'pending';
        let pillText = ord.status || 'CONFIRMED';

        if (isDeliv) {
          rowType = 'delivered';
          pillClass = 'delivered';
          pillText = 'DELIVERED';
        } else if (isRto) {
          rowType = 'rto';
          pillClass = 'rto';
          pillText = ord.status || 'RTO';
        } else if (isCanc) {
          rowType = 'cancelled';
          pillClass = 'cancelled';
          pillText = 'CANCELLED (Pre-Dispatch)';
        } else if (isInTrans) {
          rowType = 'intransit';
          pillClass = 'intransit';
          pillText = 'IN TRANSIT';
        }

        div.className = `ci-hist-row ${rowType}`;
        div.innerHTML = `
          <div>
            <div class="ci-h-id">${escapeHtml(ord.name || ('#' + ord.num))}</div>
            <div class="ci-h-date">${escapeHtml(ord.date || '')}</div>
          </div>
          <div>
            <div class="ci-h-prod">${escapeHtml(ord.items || 'Mahekh Fragrance')}</div>
            <div class="ci-h-courier">
              ${escapeHtml(ord.courier || 'Shiprocket')}
              ${ord.awb ? ('· AWB: <code>' + escapeHtml(ord.awb) + '</code>') : (isCanc ? '· (Unshipped)' : '')}
            </div>
          </div>
          <div>
            <div class="ci-h-amt">₹${Number(ord.amount || 0).toLocaleString('en-IN')}</div>
            <div class="ci-h-mode">${escapeHtml(ord.payment_mode || 'COD')}</div>
          </div>
          <div class="ci-h-status-col">
            <span class="ci-h-status-pill ${pillClass}">${escapeHtml(pillText)}</span>
            ${ord.awb ? `<br><a href="https://shiprocket.co/tracking/${encodeURIComponent(ord.awb)}" target="_blank" rel="noopener" class="ci-h-track-btn">Track Courier ↗</a>` : ''}
          </div>
        `;
        list.appendChild(div);
      });
    }

    resultBox.style.display = 'block';
    resultBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function copyCustomerSummary() {
    if (!currentActiveCustomer) return;
    const c = currentActiveCustomer;
    let cleanName = (c.name || 'Customer').trim().replace(/[.\s]+$/, '');
    const latest = (c.orders && c.orders[0]) || {};
    const text = `Customer: ${cleanName}
Phone: +91 ${c.phone || 'N/A'}
Location: ${c.city || ''} - ${c.pincode || ''}
Trust Score: ${c.trustBadge || ''}
Total Orders: ${c.totalOrders} (Delivered: ${c.deliveredOrders}, Cancelled Pre-Dispatch: ${c.cancelledOrders || 0}, Courier RTO: ${c.rtoOrders})
Total Spent: ₹${Number(c.totalSpent || 0).toLocaleString('en-IN')}
Latest Order: ${latest.name || ''} - ₹${latest.amount || 0} (${latest.payment_mode || 'COD'})
Status: ${latest.status || ''}
Courier/AWB: ${latest.courier || ''} ${latest.awb ? ('- ' + latest.awb) : ''}`;

    navigator.clipboard.writeText(text).then(() => {
      alert('✔ Customer dossier copied to clipboard for CRM/Shiprocket verification!');
    }).catch(() => {
      prompt('Copy customer dossier:', text);
    });
  }

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, function(m) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
    });
  }
</script>

