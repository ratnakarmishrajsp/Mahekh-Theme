# ========================================================
# Shopify Configuration (2026 Client Credentials Standard)
# ========================================================
# Your store myshopify domain (e.g. your-store.myshopify.com)
SHOPIFY_STORE_URL=your-store.myshopify.com

# Client ID & Secret from Shopify App (Dev Dashboard / App Credentials)
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

# API Version
SHOPIFY_API_VERSION=2024-07

# ========================================================
# Shiprocket Configuration
# ========================================================
# Registered email address for Shiprocket login
SHIPROCKET_EMAIL=your-shiprocket-email@example.com

# Shiprocket password (used to fetch JWT Auth Bearer token)
SHIPROCKET_PASSWORD=your_shiprocket_password

# ========================================================
# Sync & Storage Settings (Optional)
# ========================================================
CACHE_TTL_MINUTES=15
EXPORT_DIR=./exports
