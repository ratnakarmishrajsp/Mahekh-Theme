    $('[data-mhc-amt="cod"]').textContent = rupee(price());
    $('[data-mhc-amt="prepaid"]').textContent = rupee(prepaidPrice(price()));
    $('[data-mhc-sum="mrp"]').textContent = rupee(price());
    $('[data-mhc-sum="total"]').textContent = rupee(payable());
    $('[data-mhc-sum-offrow]').hidden = state.mode !== 'prepaid' || !D.off;
    $('[data-mhc-email]').hidden = state.mode !== 'prepaid';
    $('.mhc-submit').classList.toggle('is-pre', state.mode === 'prepaid');
    $('[data-mhc-cta]').textContent = state.mode === 'prepaid' ? 'PAY ' + rupee(payable()) + ' SECURELY →' : 'COMPLETE ORDER - ' + rupee(payable());
    var tt = $('[data-mhc-title]'); if (tt) tt.textContent = state.mode === 'prepaid' ? 'PAY ONLINE' : 'CASH ON DELIVERY';
    var lv = $('[data-mhc-li-var]'); if (lv) lv.textContent = String(state.variant.title).replace(/^[^0-9A-Za-z\u0900-\u097F]+/, '');
    var lp = $('[data-mhc-li-price]'); if (lp) lp.textContent = rupee(price());
  }
  function syncPageButtons() {
    var v = variantById(pageVariantId());
    var p = root.querySelector('[data-mhc-btnprice]'), m = root.querySelector('[data-mhc-btnmrp]');
    if (p) p.textContent = rupee(prepaidPrice(v.price));
    if (m) m.textContent = rupee(v.price);
  }
  document.addEventListener('change', function (e) { if (e.target && e.target.closest && (e.target.closest('variant-selects, variant-radios, .product-form__input') || e.target.name === 'id')) setTimeout(syncPageButtons, 60); }); // Ayush Adivasi (Trade 16): the id input changes ~0.5 s after the size click and fires its own change event
  syncPageButtons(); setTimeout(syncPageButtons, 400);

  // ---------- sheet sizing: always fits the visible screen, also with the keyboard open ----------
