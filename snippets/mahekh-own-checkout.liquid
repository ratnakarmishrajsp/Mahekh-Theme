{%- comment -%}
  Mahekh own checkout (Claude, 4 Nov 2026, v2 after the owner's phone recording).
  Two buttons: Cash on Delivery popup + Pay Online (PayU).
  Render OUTSIDE the product <form>: {% render 'mahekh-own-checkout', product: product, form_id: product_form_id %}
  Server: set mhc_api below once the order server is live. Until then the popup runs in DEMO mode (no real order).
  Add ?mh_demo=1 to any product URL to force demo mode.
{%- endcomment -%}
{%- assign mhc_api = 'https://mahekh-checkout.ratnakar-auto-dm.workers.dev' -%}
{%- assign mhc_prepaid_off = 100 -%}
{%- assign mhc_variant = product.selected_or_first_available_variant -%}

<div class="mhc" id="mhc-root" data-api="{{ mhc_api }}" data-form-id="{{ form_id }}">
  <div class="mhc-btns">
    <button type="button" class="mhc-btn mhc-btn--cod" data-mhc-open="cod" {% unless product.available %}disabled{% endunless %}>
      <span class="mhc-btn__shine" aria-hidden="true"></span>
      <span class="mhc-btn__row">
        <svg class="mhc-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.8" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="17.5" cy="17" r="1.8" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        <span class="mhc-btn__main">BUY NOW &middot; CASH ON DELIVERY</span>
      </span>
      <span class="mhc-btn__sub">Pay when your order reaches you</span>
    </button>

    <button type="button" class="mhc-btn mhc-btn--pre" data-mhc-open="prepaid" {% unless product.available %}disabled{% endunless %}>
      <span class="mhc-btn__shine" aria-hidden="true"></span>
      <span class="mhc-btn__tag">EXTRA ₹{{ mhc_prepaid_off }} OFF</span>
      <span class="mhc-btn__row">
        <svg class="mhc-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.7"/><path d="M7 14.5h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <span class="mhc-btn__main">PAY ONLINE &middot; <span data-mhc-btnprice></span></span>
      </span>
      <span class="mhc-btn__sub">UPI &middot; Cards &middot; Netbanking &middot; <s data-mhc-btnmrp></s></span>
    </button>
  </div>
</div>

<div class="mhc-overlay" id="mhc-overlay" hidden>
  <div class="mhc-sheet" role="dialog" aria-modal="true" aria-labelledby="mhc-title">

    <div class="mhc-top">
      <div class="mhc-grab" aria-hidden="true"><span></span></div>
      <div class="mhc-head">
        {%- if product.featured_media -%}
          <img class="mhc-head__img" src="{{ product.featured_media | image_url: width: 120 }}" alt="" width="44" height="44">
        {%- endif -%}
        <div class="mhc-head__txt">
          <p class="mhc-head__eyebrow">Mahekh &middot; Kannauj</p>
          <h2 class="mhc-head__title" id="mhc-title">{{ product.title | split: '–' | first | strip | escape }}</h2>
        </div>
        <button type="button" class="mhc-x" data-mhc-close aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>

    <!-- FORM VIEW: scrolling body + fixed footer with the button -->
    <form class="mhc-main mhc-view" data-view="form" novalidate autocomplete="on">
      <div class="mhc-body">
        {%- if product.has_only_default_variant == false -%}
          <p class="mhc-step">1. Choose your pack</p>
          <div class="mhc-chips" role="radiogroup" aria-label="Choose pack">
            {%- for v in product.variants -%}
              <button type="button" class="mhc-chip" role="radio" data-mhc-variant="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
                <span class="mhc-chip__t">{{ v.title | escape }}</span>
                <span class="mhc-chip__p"></span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <p class="mhc-step">{% if product.has_only_default_variant == false %}2{% else %}1{% endif %}. How will you pay?</p>
        <div class="mhc-pay" role="radiogroup" aria-label="Payment method">
          <button type="button" class="mhc-pay__opt" role="radio" data-mhc-mode="cod">
            <span class="mhc-radio" aria-hidden="true"></span>
            <span class="mhc-pay__txt"><b>Cash on Delivery</b><small>Pay when it arrives</small></span>
            <span class="mhc-pay__amt" data-mhc-amt="cod"></span>
          </button>
          <button type="button" class="mhc-pay__opt" role="radio" data-mhc-mode="prepaid">
            <span class="mhc-radio" aria-hidden="true"></span>
            <span class="mhc-pay__txt"><b>Pay Online</b><small>UPI / Cards &middot; <em>Save ₹{{ mhc_prepaid_off }}</em></small></span>
            <span class="mhc-pay__amt" data-mhc-amt="prepaid"></span>
          </button>
        </div>

        <p class="mhc-step">{% if product.has_only_default_variant == false %}3{% else %}2{% endif %}. Delivery details</p>
        <div class="mhc-fields">
          <div class="mhc-f">
            <input class="mhc-in" id="mhc-name" name="name" type="text" placeholder=" " autocomplete="name" autocapitalize="words" enterkeyhint="next" maxlength="60" required>
            <label for="mhc-name">Full name</label>
            <small class="mhc-err">Please enter your full name</small>
          </div>
          <div class="mhc-f mhc-f--phone">
            <label for="mhc-phone">Mobile number</label>
            <span class="mhc-cc" aria-hidden="true"><i class="mhc-flag"></i>+91</span>
            <input class="mhc-in" id="mhc-phone" name="phone" type="tel" inputmode="numeric" placeholder="98765 43210" autocomplete="tel-national" enterkeyhint="next" maxlength="11" required>
            <span class="mhc-ok" aria-hidden="true"></span>
            <small class="mhc-err">Enter a valid 10-digit mobile number</small>
          </div>
          <div class="mhc-grid">
            <div class="mhc-f mhc-f--pin">
              <input class="mhc-in" id="mhc-pin" name="pincode" type="tel" inputmode="numeric" placeholder=" " autocomplete="postal-code" enterkeyhint="next" maxlength="6" required>
              <label for="mhc-pin">Pincode</label>
              <span class="mhc-ok" aria-hidden="true"></span>
              <small class="mhc-err">6-digit pincode</small>
            </div>
            <div class="mhc-f">
              <input class="mhc-in" id="mhc-city" name="city" type="text" placeholder=" " autocomplete="address-level2" autocapitalize="words" enterkeyhint="next" maxlength="40" required>
              <label for="mhc-city">City / District</label>
              <small class="mhc-err">Enter city</small>
            </div>
          </div>
          <small class="mhc-pinok" hidden></small>
          <div class="mhc-f mhc-f--select">
            <select class="mhc-in" id="mhc-state" name="state" autocomplete="address-level1" required>
              <option value=""></option>
            </select>
            <label for="mhc-state">State</label>
            <small class="mhc-err">Select your state</small>
          </div>
          <div class="mhc-f">
            <input class="mhc-in" id="mhc-address" name="address" type="text" placeholder=" " autocomplete="street-address" enterkeyhint="next" maxlength="160" required>
            <label for="mhc-address">House no., street, area / village</label>
            <small class="mhc-count" data-count="address">0/20</small>
            <small class="mhc-err">Please write your full address (at least 20 letters)</small>
          </div>
          <div class="mhc-f">
            <input class="mhc-in" id="mhc-landmark" name="landmark" type="text" placeholder=" " enterkeyhint="done" maxlength="100" required>
            <label for="mhc-landmark">Landmark (near school, temple, shop…)</label>
            <small class="mhc-count" data-count="landmark">0/20</small>
            <small class="mhc-err">Please write a nearby landmark (at least 20 letters)</small>
          </div>
          <div class="mhc-f mhc-f--email" data-mhc-email hidden>
            <input class="mhc-in" id="mhc-email" name="email" type="email" placeholder=" " autocomplete="email" enterkeyhint="done" maxlength="80">
            <label for="mhc-email">Email for payment receipt (optional)</label>
          </div>
          <input type="text" name="company_website" class="mhc-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        </div>

        <div class="mhc-sum">
          <div><span>Item total</span><span data-mhc-sum="mrp"></span></div>
          <div class="mhc-sum__off" data-mhc-sum-offrow hidden><span>Online payment discount</span><span>−₹{{ mhc_prepaid_off }}</span></div>
          <div><span>Delivery</span><span class="mhc-free">FREE</span></div>
          <div class="mhc-sum__tot"><span>To pay</span><span data-mhc-sum="total"></span></div>
        </div>
      </div>

      <div class="mhc-foot">
        <p class="mhc-msg" role="alert" hidden></p>
        <button type="submit" class="mhc-submit">
          <span class="mhc-submit__shine" aria-hidden="true"></span>
          <span class="mhc-submit__txt" data-mhc-cta></span>
          <span class="mhc-submit__bar" aria-hidden="true"><i></i></span>
        </button>
        <p class="mhc-trust"><span>🚚 Free delivery</span><span>💵 Cash on delivery</span><span>🔒 Safe &amp; secure</span></p>
      </div>
    </form>

    <!-- PAYMENT REDIRECT VIEW -->
    <div class="mhc-view mhc-view--wait" data-view="wait" hidden>
      <div class="mhc-spin" aria-hidden="true"></div>
      <h3>Opening secure payment…</h3>
      <p>Please don't close this page. You will come back here after paying.</p>
    </div>

    <!-- SUCCESS VIEW -->
    <div class="mhc-view mhc-view--ok" data-view="ok" hidden>
      <div class="mhc-ok__inner">
        <div class="mhc-burst" aria-hidden="true"></div>
        <svg class="mhc-check" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29"/><path d="M19 33l9 9 17-19"/></svg>
        <h3 class="mhc-ok__title">Order Confirmed!</h3>
        <p class="mhc-ok__no" data-mhc-okno></p>
        <div class="mhc-ok__card">
          <div><span>Product</span><b data-mhc-okprod></b></div>
          <div><span>Payment</span><b data-mhc-okpay></b></div>
          <div><span>Delivery to</span><b data-mhc-okaddr></b></div>
          <div><span>Arrives in</span><b>3–5 days &middot; FREE</b></div>
        </div>
        <p class="mhc-ok__note" data-mhc-oknote></p>
        <button type="button" class="mhc-submit mhc-submit--light" data-mhc-close>Continue shopping</button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="mhc-data">
{
  "product": {{ product.title | json }},
  "handle": {{ product.handle | json }},
  "off": {{ mhc_prepaid_off | times: 100 }},
  "variant": {{ mhc_variant.id | json }},
  "variants": [{%- for v in product.variants -%}{"id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price }}, "available": {{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
}
</script>

<style>
  .mhc,.mhc-sheet{--mhc-gold:#cca43b;--mhc-gold2:#e9cf7a;--mhc-brown:#1d1107;--mhc-brown2:#3a2211;--mhc-ink:#1a1107;--mhc-muted:#76644a;--mhc-line:#e6dcc7;--mhc-bg:#fffdf8;--mhc-ease:cubic-bezier(.22,1,.36,1)}
  .mhc{margin:.4rem 0 .2rem;display:none}
  .mhc.is-ready{display:block}
  /* only where our script is running: hide Fastrr's button, Add to cart and the old prepaid pill of THIS product form */
  .mhc-on-form .product-form__submit,.mhc-on-form .shiprocket-headless,.mhc-on-form .sr-headless-checkout,.mhc-on-form .shopify-payment-button,.mhc-on-form .prepaid-savings-pill{display:none!important}
  .mhc [hidden],.mhc-sheet [hidden]{display:none!important}

  /* ---------- page buttons ---------- */
  .mhc-btns{display:flex;flex-direction:column;gap:1rem}
  .mhc-btn{position:relative;overflow:hidden;width:100%;min-height:6.2rem;padding:1rem 1.4rem;border-radius:12px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.25rem;font-family:var(--font-body-family);-webkit-tap-highlight-color:transparent;transition:transform .18s var(--mhc-ease),box-shadow .25s var(--mhc-ease);letter-spacing:.06em;touch-action:manipulation}
  .mhc-btn:active{transform:scale(.975)}
  .mhc-btn[disabled]{opacity:.5;cursor:not-allowed;animation:none}
  .mhc-btn--cod{background:linear-gradient(135deg,var(--mhc-brown) 0%,var(--mhc-brown2) 100%);color:var(--mhc-gold);border:1.5px solid rgba(204,164,59,.55);box-shadow:0 10px 24px -8px rgba(29,17,7,.55),inset 0 1px 0 rgba(233,207,122,.18);animation:mhcGlow 3.2s ease-in-out infinite}
  .mhc-btn--pre{background:linear-gradient(135deg,#f3dc8e 0%,var(--mhc-gold) 55%,#b18a2b 100%);color:var(--mhc-ink);border:1.5px solid #b18a2b;box-shadow:0 10px 22px -10px rgba(177,138,43,.8),inset 0 1px 0 rgba(255,255,255,.45);padding-top:2.3rem}
  .mhc-btn__row{display:flex;align-items:center;gap:.7rem}
  .mhc-btn__main{font-family:var(--font-heading-family);font-weight:700;font-size:1.55rem;line-height:1.2}
  .mhc-btn__sub{font-size:1.15rem;letter-spacing:.02em;opacity:.85;font-weight:500}
  .mhc-btn--cod .mhc-btn__sub{color:#e9d9a8}
  .mhc-btn__sub s{opacity:.7}
  .mhc-ico{width:2.2rem;height:2.2rem;flex:none}
  .mhc-btn__tag{position:absolute;top:0;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--mhc-brown);color:var(--mhc-gold2);font-size:.95rem;font-weight:800;letter-spacing:.08em;padding:.3rem .8rem;border-radius:0 0 10px 10px}
  .mhc-btn__shine{position:absolute;top:-60%;left:-40%;width:35%;height:220%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.38),transparent);transform:rotate(22deg) translateX(-160%);animation:mhcShine 4.2s ease-in-out infinite;pointer-events:none}
  .mhc-btn--pre .mhc-btn__shine{animation-delay:2.1s;background:linear-gradient(90deg,transparent,rgba(255,255,255,.6),transparent)}
  @keyframes mhcShine{0%{transform:rotate(22deg) translateX(-160%)}28%,100%{transform:rotate(22deg) translateX(520%)}}
  @keyframes mhcGlow{0%,100%{box-shadow:0 10px 24px -8px rgba(29,17,7,.55),0 0 0 0 rgba(204,164,59,0)}50%{box-shadow:0 12px 28px -8px rgba(29,17,7,.6),0 0 0 6px rgba(204,164,59,.14)}}

  /* ---------- overlay + full-height sheet ---------- */
  .mhc-overlay{position:fixed;inset:0;z-index:2147483647;background:rgba(18,11,4,0);transition:background .3s ease;-webkit-tap-highlight-color:transparent}
  .mhc-overlay.is-open{background:rgba(18,11,4,.6)}
  html.mhc-on #PBarNextFrameWrapper,html.mhc-on #PBarNextFrame,html.mhc-on #preview-bar-iframe{display:none!important}
  .mhc-sheet{position:absolute;left:0;right:0;top:10px;bottom:0;display:flex;flex-direction:column;background:var(--mhc-bg);border-radius:18px 18px 0 0;box-shadow:0 -10px 40px rgba(0,0,0,.28);transform:translateY(105%);transition:transform .45s var(--mhc-ease);font-family:var(--font-body-family);color:var(--mhc-ink);overflow:hidden;will-change:transform}
  .mhc-overlay.is-open .mhc-sheet{transform:translateY(0)}
  .mhc-sheet.is-drag{transition:none}
  @media (min-width:750px){
    .mhc-sheet{left:50%;right:auto;top:50%;bottom:auto;width:460px;height:min(760px,90vh);border-radius:18px;transform:translate(-50%,-46%) scale(.97);opacity:0;transition:transform .38s var(--mhc-ease),opacity .25s ease}
    .mhc-overlay.is-open .mhc-sheet{transform:translate(-50%,-50%);opacity:1}
    .mhc-grab{visibility:hidden;height:.6rem!important;padding:0!important}
  }

  .mhc-top{flex:none;background:var(--mhc-bg);border-bottom:1px solid #f0e7d6;padding:0 1.6rem 1rem;touch-action:none;cursor:grab}
  .mhc-grab{display:flex;justify-content:center;padding:.8rem 0 .9rem}
  .mhc-grab span{width:4.4rem;height:.45rem;border-radius:9px;background:#ddd0b6}
  .mhc-head{display:flex;align-items:center;gap:1.1rem}
  .mhc-head__img{width:4.4rem;height:4.4rem;border-radius:10px;object-fit:cover;border:1px solid var(--mhc-line);flex:none}
  .mhc-head__txt{flex:1;min-width:0}
  .mhc-head__eyebrow{margin:0;font-size:1rem;letter-spacing:.14em;text-transform:uppercase;color:#a07f2a;font-weight:600}
  .mhc-head__title{margin:.1rem 0 0;font-family:var(--font-heading-family);font-size:1.6rem;line-height:1.25;font-weight:700;color:var(--mhc-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mhc-x{flex:none;width:3.6rem;height:3.6rem;border-radius:50%;border:0;background:#f4ede0;color:#5b4630;display:grid;place-items:center;cursor:pointer;transition:transform .2s,background .2s}
  .mhc-x:active{transform:scale(.92)}
  .mhc-x svg{width:1.8rem;height:1.8rem}

  .mhc-main{flex:1;min-height:0;display:flex;flex-direction:column;margin:0}
  .mhc-body{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding:1.4rem 1.6rem 2.4rem;scroll-behavior:smooth;scroll-padding:2rem}
  .mhc-body::-webkit-scrollbar{width:0}
  .mhc-step{margin:1.4rem 0 .8rem;font-size:1.15rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#9c7a24}
  .mhc-step:first-child{margin-top:0}

  .mhc-chips{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:.8rem}
  .mhc-chip{display:flex;flex-direction:column;align-items:flex-start;gap:.2rem;padding:1rem 1.2rem;border-radius:12px;border:1.5px solid var(--mhc-line);background:#fff;cursor:pointer;font-family:inherit;color:var(--mhc-ink);transition:border-color .2s,box-shadow .2s,transform .15s;text-align:left}
  .mhc-chip__t{font-size:1.25rem;font-weight:600;line-height:1.3}
  .mhc-chip__p{font-size:1.35rem;color:#8a6a1d;font-weight:700}
  .mhc-chip.is-on{border-color:var(--mhc-gold);background:linear-gradient(180deg,#fffaf0,#fff4dc);box-shadow:0 0 0 3px rgba(204,164,59,.18)}
  .mhc-chip:active{transform:scale(.98)}

  .mhc-pay{display:grid;gap:.8rem}
  .mhc-pay__opt{display:flex;align-items:center;gap:1.1rem;width:100%;padding:1.1rem 1.3rem;border-radius:14px;border:1.5px solid var(--mhc-line);background:#fff;cursor:pointer;text-align:left;font-family:inherit;color:var(--mhc-ink);transition:border-color .2s,background .2s,box-shadow .2s}
  .mhc-pay__opt.is-on{border-color:var(--mhc-gold);background:#fffaf0;box-shadow:0 0 0 3px rgba(204,164,59,.16)}
  .mhc-pay__txt{display:flex;flex-direction:column;flex:1;gap:.1rem}
  .mhc-pay__txt b{font-size:1.4rem;font-weight:700}
  .mhc-pay__txt small{font-size:1.15rem;color:var(--mhc-muted)}
  .mhc-pay__txt em{font-style:normal;color:#1f7a3d;font-weight:700}
  .mhc-pay__amt{font-family:var(--font-heading-family);font-weight:700;font-size:1.55rem}
  .mhc-radio{width:2rem;height:2rem;border-radius:50%;border:2px solid #cdbf9f;flex:none;position:relative;transition:border-color .2s}
  .mhc-radio::after{content:'';position:absolute;inset:3px;border-radius:50%;background:var(--mhc-gold);transform:scale(0);transition:transform .25s var(--mhc-ease)}
  .is-on>.mhc-radio{border-color:var(--mhc-gold)}
  .is-on>.mhc-radio::after{transform:scale(1)}

  /* ---------- fields ---------- */
  .mhc-fields{display:grid;gap:1rem}
  .mhc-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:1rem}
  .mhc-f{position:relative}
  .mhc-in{display:block;width:100%;height:5.4rem;padding:1.9rem 1.3rem .6rem;border-radius:12px;border:1.5px solid #e2d7c1;background:#fff;font-family:var(--font-body-family);font-size:16px;line-height:2.2rem;color:var(--mhc-ink);outline:none;transition:border-color .2s,box-shadow .2s;-webkit-appearance:none;appearance:none;box-sizing:border-box;margin:0}
  .mhc-in:-webkit-autofill{-webkit-box-shadow:0 0 0 40px #fff inset;-webkit-text-fill-color:var(--mhc-ink)}
  .mhc-f label{position:absolute;left:1.35rem;top:1.7rem;font-size:1.45rem;line-height:2rem;color:#8e7f68;pointer-events:none;transform-origin:left top;transition:transform .2s var(--mhc-ease),color .2s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:calc(100% - 2.6rem)}
  .mhc-in:focus{border-color:var(--mhc-gold);box-shadow:0 0 0 3px rgba(204,164,59,.18)}
  .mhc-in:focus+label,.mhc-in:not(:placeholder-shown)+label{transform:translateY(-1.15rem) scale(.78);color:#9c7a24}
  .mhc-f--select .mhc-in+label{transform:none;color:#8e7f68}
  .mhc-f--select.has-val .mhc-in+label,.mhc-f--select .mhc-in:focus+label{transform:translateY(-1.15rem) scale(.78);color:#9c7a24}
  .mhc-f--select select{padding-right:3.6rem;background-image:linear-gradient(45deg,transparent 50%,#9c7a24 50%),linear-gradient(135deg,#9c7a24 50%,transparent 50%);background-position:calc(100% - 2rem) 2.5rem,calc(100% - 1.5rem) 2.5rem;background-size:5px 5px;background-repeat:no-repeat}
  /* phone: label always on top, +91 sits on the same line as the number */
  .mhc-f--phone label{left:1.35rem;transform:translateY(-1.15rem) scale(.78);color:#9c7a24;z-index:1}
  .mhc-f--phone .mhc-in{padding-left:7.6rem;letter-spacing:.06em;font-weight:500}
  .mhc-f--phone .mhc-in::placeholder{color:#c9bba0;letter-spacing:.06em;font-weight:400}
