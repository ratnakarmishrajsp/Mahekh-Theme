  var gtagEv = function (ev, p) { try { if (window.gtag) gtag('event', ev, p); } catch (e) {} };
  // 19 Nov 2026: every checkout step also goes to our own server (POST /t → D1). mahekh.in also keeps the GA4 events (G-W2TG8R79DY).
  var VID = (function () { try { var v = localStorage.getItem('mh_vid'); if (!v) { v = 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8); localStorage.setItem('mh_vid', v); } return v; } catch (e) { return ''; } })();
  var PVID = 'pv' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  // mahekh 19 Nov 2026: a real test order (name starts "TEST ORDER") marks the rest of this tab's steps as test too
  function isTestName() {
    try {
      var el = document.getElementById('mhc-name');
