  .mhc-dots i:nth-child(2){animation-delay:.15s}.mhc-dots i:nth-child(3){animation-delay:.3s}
  @keyframes mhcDot{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}
  .mhc-trust{display:flex;justify-content:center;flex-wrap:wrap;gap:.3rem 1.3rem;margin:.7rem 0 0;font-size:1.1rem;color:var(--mhc-muted)}
  .mhc-sheet.kb .mhc-trust{display:none}

  /* ---------- wait + success ---------- */
  .mhc-view{animation:mhcIn .35s var(--mhc-ease)}
  @keyframes mhcIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .mhc-view--wait{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:2rem 2.4rem 6rem}
  .mhc-view--wait h3{font-family:var(--font-heading-family);font-size:1.9rem;margin:1.8rem 0 .6rem}
  .mhc-view--wait p{font-size:1.35rem;color:var(--mhc-muted);margin:0;max-width:30rem}
  .mhc-spin{width:5.2rem;height:5.2rem;border-radius:50%;border:4px solid #f0e6d0;border-top-color:var(--mhc-gold);animation:mhcRot .8s linear infinite}
  @keyframes mhcRot{to{transform:rotate(360deg)}}
  .mhc-view--ok{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;display:flex}
  .mhc-ok__inner{margin:auto;width:100%;max-width:42rem;text-align:center;padding:2.4rem 2rem calc(2.4rem + env(safe-area-inset-bottom));position:relative}
  .mhc-check{width:9rem;height:9rem;margin:0 auto;display:block}
  .mhc-check circle{fill:#1f7a3d;stroke:none;transform-origin:center;animation:mhcPop .5s var(--mhc-ease) both}
  .mhc-check path{fill:none;stroke:#fff;stroke-width:5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:48;stroke-dashoffset:48;animation:mhcDraw .45s .35s ease-out forwards}
  @keyframes mhcPop{0%{transform:scale(0)}70%{transform:scale(1.12)}100%{transform:scale(1)}}
  @keyframes mhcDraw{to{stroke-dashoffset:0}}
  .mhc-ok__title{font-family:var(--font-heading-family);font-size:2.5rem;margin:1.4rem 0 .3rem;color:var(--mhc-ink)}
  .mhc-ok__no{margin:0 0 1.6rem;font-size:1.4rem;color:var(--mhc-muted)}
  .mhc-ok__no b{color:var(--mhc-ink);letter-spacing:.04em}
  .mhc-ok__card{display:grid;gap:.7rem;text-align:left;padding:1.3rem 1.4rem;border-radius:14px;background:#faf5ea;border:1px solid #efe4cc;font-size:1.3rem}
  .mhc-ok__card div{display:flex;justify-content:space-between;gap:1.2rem}
  .mhc-ok__card span{color:var(--mhc-muted);flex:none}
  .mhc-ok__card b{text-align:right;font-weight:600}
  .mhc-ok__note{font-size:1.3rem;color:var(--mhc-muted);margin:1.3rem 0 0;line-height:1.5}
  .mhc-burst{position:absolute;left:50%;top:7rem;width:0;height:0;pointer-events:none}
  .mhc-burst i{position:absolute;width:8px;height:12px;border-radius:2px;opacity:0;animation:mhcConf 1.1s cubic-bezier(.15,.7,.3,1) forwards}
  @keyframes mhcConf{0%{opacity:1;transform:translate(0,0) rotate(0)}100%{opacity:0;transform:translate(var(--x),var(--y)) rotate(var(--r))}}

  @media (prefers-reduced-motion:reduce){.mhc-btn,.mhc-btn__shine,.mhc-submit__shine{animation:none!important}.mhc-sheet,.mhc-overlay{transition:none}.mhc-burst{display:none}}
</style>

<script>
(function () {
  if (window.MHC) return;
  var root = document.getElementById('mhc-root');
  var ov = document.getElementById('mhc-overlay');
  if (!root || !ov) return;
  document.body.appendChild(ov); // escape transformed parents so the sheet is truly fixed
  // switch this product form over to our buttons (quick-add modals, where this script never runs, keep Fastrr)
  (function () {
    var pf = document.getElementById(root.getAttribute('data-form-id') || '');
    var wrap = pf && (pf.closest('product-form') || pf.closest('.product-form') || pf.parentElement);
    if (wrap) wrap.classList.add('mhc-on-form');
    root.classList.add('is-ready');
  })();

  var D = JSON.parse(document.getElementById('mhc-data').textContent);
  var PIXEL = '596578329419010';
  // safety net: the Meta pixel normally comes from Shopify's Facebook app; if it is missing, load and init it ourselves
  (function ensurePixel() {
    var go = function () {
      try {
        if (!window.fbq) {
          !function (f, b, e, v, n, t, s) { if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); }; if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = []; t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s); }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', PIXEL);
        } else if (fbq.instance && fbq.instance.pixelsByID && !fbq.instance.pixelsByID[PIXEL]) {
          fbq('init', PIXEL);
        }
      } catch (e) {}
    };
    if (document.readyState === 'complete') setTimeout(go, 2000); else window.addEventListener('load', function () { setTimeout(go, 2000); });
  })();
  var API = (root.getAttribute('data-api') || '').replace(/\/$/, '');
  var qs = new URLSearchParams(location.search);
  var DEMO = !API || qs.get('mh_demo') === '1';
  var TEST_KEY = (function () { try { var k = qs.get('mh_test'); if (k) sessionStorage.setItem('mh_test', k); return k || sessionStorage.getItem('mh_test') || ''; } catch (e) { return qs.get('mh_test') || ''; } })();
  var sheet = ov.querySelector('.mhc-sheet');
  var form = ov.querySelector('.mhc-main');
  var body = ov.querySelector('.mhc-body');
  var $ = function (s, c) { return (c || ov).querySelector(s); };
  var $$ = function (s, c) { return Array.prototype.slice.call((c || ov).querySelectorAll(s)); };
  var state = { mode: 'cod', variant: null, busy: false, audio: null, eid: '' };

  var STATES = ['Andaman and Nicobar Islands','Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chandigarh','Chhattisgarh','Dadra and Nagar Haveli and Daman and Diu','Delhi','Goa','Gujarat','Haryana','Himachal Pradesh','Jammu and Kashmir','Jharkhand','Karnataka','Kerala','Ladakh','Lakshadweep','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram','Nagaland','Odisha','Puducherry','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana','Tripura','Uttar Pradesh','Uttarakhand','West Bengal'];
  var sel = $('#mhc-state');
  STATES.forEach(function (s) { var o = document.createElement('option'); o.value = s; o.textContent = s; sel.appendChild(o); });

  // ---------- helpers ----------
  var rupee = function (paise) { return '₹' + Math.round(paise / 100).toLocaleString('en-IN'); };
  var store = {
    get: function (k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } },
    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  };
  var uid = function () { return 'mh' + Date.now().toString(36) + Math.random().toString(36).slice(2, 9); };
  var cookie = function (n) { var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)'); return m ? decodeURIComponent(m[1]) : ''; };
  var vib = function (p) { try { navigator.vibrate && navigator.vibrate(p); } catch (e) {} };
  var track = function (ev, params, eventID) { try { if (window.fbq) fbq('trackSingle', PIXEL, ev, params || {}, eventID ? { eventID: eventID } : undefined); } catch (e) {} };
  var gtagEv = function (ev, p) { try { if (window.gtag) gtag('event', ev, p); } catch (e) {} };
  var digits = function (s) { return String(s || '').replace(/\D/g, ''); };

  // attribution (same note keys Fastrr used)
  (function captureAttr() {
    var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'fbclid', 'gclid'];
    var hit = keys.some(function (k) { return qs.get(k); });
    if (hit) {
      var a = { landing_page_url: location.href, ts: Date.now() };
      keys.forEach(function (k) { if (qs.get(k)) a[k] = qs.get(k); });
      store.set('mh_attr', a);
    } else if (!store.get('mh_attr')) store.set('mh_attr', { landing_page_url: location.href, ts: Date.now() });
  })();

  // ---------- variant + prices ----------
  function pageVariantId() {
    var pf = document.getElementById(root.getAttribute('data-form-id') || '');
    var inp = (pf && pf.querySelector('input[name="id"]')) || document.querySelector('form[action*="/cart/add"] input[name="id"]');
    return inp && inp.value ? Number(inp.value) : D.variant;
  }
  function variantById(id) { for (var i = 0; i < D.variants.length; i++) if (D.variants[i].id === Number(id)) return D.variants[i]; return D.variants[0]; }
  function price() { return state.variant.price; }
  function prepaidPrice(p) { return Math.max(p - D.off, 100); }
  function payable() { return state.mode === 'prepaid' ? prepaidPrice(price()) : price(); }

  function render() {
    $$('.mhc-chip').forEach(function (c) { var v = variantById(c.dataset.mhcVariant), on = v.id === state.variant.id; c.classList.toggle('is-on', on); c.setAttribute('aria-checked', on); c.querySelector('.mhc-chip__p').textContent = rupee(v.price); });
    $$('.mhc-pay__opt').forEach(function (b) { var on = b.dataset.mhcMode === state.mode; b.classList.toggle('is-on', on); b.setAttribute('aria-checked', on); });
    $('[data-mhc-amt="cod"]').textContent = rupee(price());
    $('[data-mhc-amt="prepaid"]').textContent = rupee(prepaidPrice(price()));
    $('[data-mhc-sum="mrp"]').textContent = rupee(price());
    $('[data-mhc-sum="total"]').textContent = rupee(payable());
    $('[data-mhc-sum-offrow]').hidden = state.mode !== 'prepaid';
    $('[data-mhc-email]').hidden = state.mode !== 'prepaid';
    $('.mhc-submit').classList.toggle('is-pre', state.mode === 'prepaid');
    $('[data-mhc-cta]').textContent = state.mode === 'prepaid' ? 'PAY ' + rupee(payable()) + ' SECURELY →' : 'CONFIRM ORDER · ' + rupee(payable()) + ' COD';
  }
  function syncPageButtons() {
    var v = variantById(pageVariantId());
    var p = root.querySelector('[data-mhc-btnprice]'), m = root.querySelector('[data-mhc-btnmrp]');
    if (p) p.textContent = rupee(prepaidPrice(v.price));
    if (m) m.textContent = rupee(v.price);
  }
  document.addEventListener('change', function (e) { if (e.target && e.target.closest && e.target.closest('variant-selects, variant-radios, .product-form__input')) setTimeout(syncPageButtons, 60); });
  syncPageButtons(); setTimeout(syncPageButtons, 400);

  // ---------- sheet sizing: always fits the visible screen, also with the keyboard open ----------
  var GAP = 10;
  function fit() {
    if (ov.hidden) return;
    if (window.innerWidth >= 750) { sheet.style.top = sheet.style.height = sheet.style.bottom = ''; sheet.classList.remove('kb'); return; }
    var vv = window.visualViewport;
    var h = vv ? vv.height : window.innerHeight, top = vv ? vv.offsetTop : 0;
    sheet.style.top = (top + GAP) + 'px';
    sheet.style.height = Math.max(h - GAP, 320) + 'px';
    sheet.style.bottom = 'auto';
    sheet.classList.toggle('kb', h < window.innerHeight - 140);
  }
  if (window.visualViewport) { visualViewport.addEventListener('resize', fit); visualViewport.addEventListener('scroll', fit); }
  window.addEventListener('resize', fit);

  // ---------- open / close (+ phone back button closes the popup) ----------
  var lastFocus = null, pushed = false;
  function open(mode) {
    if (state.busy) return;
    state.mode = mode === 'prepaid' ? 'prepaid' : 'cod';
    state.variant = variantById(pageVariantId());
    restore(); showView('form'); render(); msg('');
    lastFocus = document.activeElement;
    ov.hidden = false; fit(); void ov.offsetHeight;
    ov.classList.add('is-open');
    document.documentElement.style.overflow = 'hidden';
    document.documentElement.classList.add('mhc-on');
    body.scrollTop = 0;
    try { history.pushState({ mhc: 1 }, ''); pushed = true; } catch (e) {}
    vib(12);
    state.eid = uid();
    track('InitiateCheckout', { value: payable() / 100, currency: 'INR', content_ids: [String(state.variant.id)], content_type: 'product', num_items: 1 }, 'ic_' + state.eid);
    gtagEv('begin_checkout', { currency: 'INR', value: payable() / 100, items: [{ item_id: String(state.variant.id), item_name: D.product, item_variant: state.variant.title, price: price() / 100, quantity: 1 }] });
  }
  function hide() {
    ov.classList.remove('is-open');
    sheet.style.transform = '';
    if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
    setTimeout(function () { ov.hidden = true; document.documentElement.style.overflow = ''; document.documentElement.classList.remove('mhc-on'); }, 420);
    if (lastFocus && lastFocus.focus) try { lastFocus.focus({ preventScroll: true }); } catch (e) {}
  }
  function close() {
    if (state.busy || ov.hidden) return;
    if (pushed) { pushed = false; history.back(); return; } // popstate below hides it
    hide();
  }
  window.addEventListener('popstate', function () { if (!ov.hidden && !state.busy) { pushed = false; hide(); } });
  function showView(v) { $$('.mhc-view').forEach(function (el) { el.hidden = el.dataset.view !== v; }); }

  root.addEventListener('click', function (e) { var b = e.target.closest('[data-mhc-open]'); if (b && !b.disabled) open(b.dataset.mhcOpen); });
  ov.addEventListener('click', function (e) {
    if (e.target === ov || e.target.closest('[data-mhc-close]')) return close();
    var c = e.target.closest('.mhc-chip'); if (c && !c.disabled) { state.variant = variantById(c.dataset.mhcVariant); render(); vib(8); return; }
    var p = e.target.closest('.mhc-pay__opt'); if (p) { state.mode = p.dataset.mhcMode; render(); vib(8); }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !ov.hidden) close(); });

  // drag the header down to close
  (function swipe() {
    var top = $('.mhc-top'), y0 = null, dy = 0;
    top.addEventListener('touchstart', function (e) { if (e.target.closest('.mhc-x')) return; y0 = e.touches[0].clientY; dy = 0; sheet.classList.add('is-drag'); }, { passive: true });
    top.addEventListener('touchmove', function (e) { if (y0 === null) return; dy = Math.max(0, e.touches[0].clientY - y0); sheet.style.transform = 'translateY(' + dy + 'px)'; }, { passive: true });
    top.addEventListener('touchend', function () { if (y0 === null) return; sheet.classList.remove('is-drag'); y0 = null; if (dy > 120) close(); else sheet.style.transform = ''; });
  })();

  // ---------- form ----------
  var F = { name: $('#mhc-name'), phone: $('#mhc-phone'), pincode: $('#mhc-pin'), city: $('#mhc-city'), state: sel, address: $('#mhc-address'), landmark: $('#mhc-landmark'), email: $('#mhc-email') };
  var ORDER = ['name', 'phone', 'pincode', 'city', 'state', 'address', 'landmark', 'email'];
  function fmtPhone(d) { return d.length > 5 ? d.slice(0, 5) + ' ' + d.slice(5) : d; }
  function restore() {
    var s = store.get('mh_ck_addr');
    if (s) Object.keys(F).forEach(function (k) { if (s[k] && !F[k].value) F[k].value = k === 'phone' ? fmtPhone(digits(s[k]).slice(-10)) : s[k]; });
    sel.closest('.mhc-f').classList.toggle('has-val', !!sel.value);
    markValid();
  }
  var saveT = null;
  function save() { clearTimeout(saveT); saveT = setTimeout(function () { var s = {}; Object.keys(F).forEach(function (k) { s[k] = k === 'phone' ? digits(F[k].value) : F[k].value.trim(); }); store.set('mh_ck_addr', s); }, 300); }
  var MIN_ADDR = 20;
  function markValid() {
    F.phone.closest('.mhc-f').classList.toggle('is-valid', /^[6-9]\d{9}$/.test(digits(F.phone.value)));
    F.pincode.closest('.mhc-f').classList.toggle('is-valid', /^[1-9]\d{5}$/.test(F.pincode.value));
    ['address', 'landmark'].forEach(function (k) {
      var n = F[k].value.trim().length, c = $('[data-count="' + k + '"]');
      if (c) { c.textContent = n >= MIN_ADDR ? '✓ ' + n + ' letters' : n + '/' + MIN_ADDR; c.classList.toggle('is-ok', n >= MIN_ADDR); }
    });
  }
  F.address.addEventListener('input', markValid);
  F.landmark.addEventListener('input', markValid);

  F.phone.addEventListener('input', function () {
    var d = digits(F.phone.value);
    if (d.length > 10 && (d.indexOf('91') === 0 || d.indexOf('0') === 0)) d = d.slice(-10);
    F.phone.value = fmtPhone(d.slice(0, 10));
    markValid();
    if (d.length === 10 && /^[6-9]/.test(d) && document.activeElement === F.phone) setTimeout(function () { if (!F.pincode.value) F.pincode.focus(); }, 120);
  });
  sel.addEventListener('change', function () { sel.closest('.mhc-f').classList.toggle('has-val', !!sel.value); clearBad(sel); save(); });

  // pincode -> state at once (prefix), city from India Post (slow, best effort)
  var PFX3 = { '160': 'Chandigarh', '194': 'Ladakh', '403': 'Goa', '605': 'Puducherry', '737': 'Sikkim', '744': 'Andaman and Nicobar Islands', '790': 'Arunachal Pradesh', '791': 'Arunachal Pradesh', '792': 'Arunachal Pradesh', '793': 'Meghalaya', '794': 'Meghalaya', '795': 'Manipur', '796': 'Mizoram', '797': 'Nagaland', '798': 'Nagaland', '799': 'Tripura', '246': 'Uttarakhand', '247': 'Uttarakhand', '248': 'Uttarakhand', '249': 'Uttarakhand', '262': 'Uttarakhand', '263': 'Uttarakhand', '396': 'Gujarat' };
  var PFX2 = { '11': 'Delhi', '12': 'Haryana', '13': 'Haryana', '14': 'Punjab', '15': 'Punjab', '16': 'Punjab', '17': 'Himachal Pradesh', '18': 'Jammu and Kashmir', '19': 'Jammu and Kashmir', '20': 'Uttar Pradesh', '21': 'Uttar Pradesh', '22': 'Uttar Pradesh', '23': 'Uttar Pradesh', '24': 'Uttar Pradesh', '25': 'Uttar Pradesh', '26': 'Uttar Pradesh', '27': 'Uttar Pradesh', '28': 'Uttar Pradesh', '30': 'Rajasthan', '31': 'Rajasthan', '32': 'Rajasthan', '33': 'Rajasthan', '34': 'Rajasthan', '36': 'Gujarat', '37': 'Gujarat', '38': 'Gujarat', '39': 'Gujarat', '40': 'Maharashtra', '41': 'Maharashtra', '42': 'Maharashtra', '43': 'Maharashtra', '44': 'Maharashtra', '45': 'Madhya Pradesh', '46': 'Madhya Pradesh', '47': 'Madhya Pradesh', '48': 'Madhya Pradesh', '49': 'Chhattisgarh', '50': 'Telangana', '51': 'Andhra Pradesh', '52': 'Andhra Pradesh', '53': 'Andhra Pradesh', '56': 'Karnataka', '57': 'Karnataka', '58': 'Karnataka', '59': 'Karnataka', '60': 'Tamil Nadu', '61': 'Tamil Nadu', '62': 'Tamil Nadu', '63': 'Tamil Nadu', '64': 'Tamil Nadu', '67': 'Kerala', '68': 'Kerala', '69': 'Kerala', '70': 'West Bengal', '71': 'West Bengal', '72': 'West Bengal', '73': 'West Bengal', '74': 'West Bengal', '75': 'Odisha', '76': 'Odisha', '77': 'Odisha', '78': 'Assam', '80': 'Bihar', '81': 'Jharkhand', '82': 'Jharkhand', '83': 'Jharkhand', '84': 'Bihar', '85': 'Bihar' };
  var pinSeq = 0, pinHint = $('.mhc-pinok');
  F.pincode.addEventListener('input', function () {
    F.pincode.value = digits(F.pincode.value).slice(0, 6);
    var pin = F.pincode.value;
    markValid();
    pinHint.hidden = true;
    if (!/^[1-9]\d{5}$/.test(pin)) return;
    var guess = PFX3[pin.slice(0, 3)] || PFX2[pin.slice(0, 2)];
    if (guess) { sel.value = guess; sel.closest('.mhc-f').classList.add('has-val'); clearBad(sel); }
    if (document.activeElement === F.pincode) setTimeout(function () { (F.city.value ? F.address : F.city).focus(); }, 150);
    var my = ++pinSeq, ctl = window.AbortController ? new AbortController() : null;
    var t = setTimeout(function () { ctl && ctl.abort(); }, 7000);
    fetch('https://api.postalpincode.in/pincode/' + pin, ctl ? { signal: ctl.signal } : {})
      .then(function (r) { return r.json(); })
      .then(function (j) {
        clearTimeout(t);
        if (my !== pinSeq) return;
        var po = j && j[0] && j[0].Status === 'Success' && j[0].PostOffice && j[0].PostOffice[0];
        if (!po) return;
        if (!F.city.value) F.city.value = po.District;
        var st = STATES.filter(function (s) { return s.toLowerCase() === String(po.State).toLowerCase(); })[0];
        if (st) { sel.value = st; sel.closest('.mhc-f').classList.add('has-val'); }
        clearBad(F.city); clearBad(sel); save();
        pinHint.textContent = '📍 Delivering to ' + po.District + ', ' + po.State;
        pinHint.hidden = false;
        if (document.activeElement === F.city && F.city.value) F.address.focus();
      }).catch(function () {});
  });

  function bad(el) { var f = el.closest('.mhc-f'); f.classList.remove('is-bad'); void f.offsetWidth; f.classList.add('is-bad'); }
  function clearBad(el) { var f = el.closest('.mhc-f'); f && f.classList.remove('is-bad'); }
  Object.keys(F).forEach(function (k) { F[k].addEventListener('input', function () { clearBad(F[k]); save(); }); });

  // keyboard "Next" moves to the next field; the last one submits
  ORDER.forEach(function (k, i) {
    F[k].addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' || F[k].tagName === 'SELECT') return;
      e.preventDefault();
      for (var j = i + 1; j < ORDER.length; j++) { var n = F[ORDER[j]]; if (n && !n.closest('[hidden]') && n.offsetParent !== null) { if (n.tagName === 'SELECT' && n.value) continue; n.focus(); return; } }
      F[k].blur();
      if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true }));
    });
  });
  // keep the focused field in the middle of the visible area (keyboard open)
  body.addEventListener('focusin', function (e) {
    var el = e.target; if (!el.matches || !el.matches('.mhc-in')) return;
    setTimeout(function () { fit(); var f = el.closest('.mhc-f') || el; var r = f.getBoundingClientRect(), b = body.getBoundingClientRect(); if (r.top < b.top + 12 || r.bottom > b.bottom - 12) body.scrollTo({ top: body.scrollTop + (r.top - b.top) - (b.height - r.height) / 2, behavior: 'smooth' }); }, 320);
  });

  function validate() {
    var ok = true, first = null;
    var chk = function (el, cond) { if (!cond) { bad(el); ok = false; first = first || el; } };
    chk(F.name, /[A-Za-zऀ-ॿ]{2,}/.test(F.name.value) && F.name.value.trim().length >= 3);
    chk(F.phone, /^[6-9]\d{9}$/.test(digits(F.phone.value)));
    chk(F.pincode, /^[1-9]\d{5}$/.test(F.pincode.value));
    chk(F.city, F.city.value.trim().length >= 2);
    chk(sel, !!sel.value);
    chk(F.address, F.address.value.trim().length >= MIN_ADDR);
    chk(F.landmark, F.landmark.value.trim().length >= MIN_ADDR);
    if (state.mode === 'prepaid' && F.email.value && !/^\S+@\S+\.\S+$/.test(F.email.value)) chk(F.email, false);
    if (first) {
      var f = first.closest('.mhc-f'), r = f.getBoundingClientRect(), b = body.getBoundingClientRect();
      body.scrollTo({ top: body.scrollTop + (r.top - b.top) - 70, behavior: 'smooth' });
      msg('Please fill the highlighted details.');
      vib([20, 40, 20]);
    }
    return ok;
  }
  function msg(t) { var m = $('.mhc-msg'); m.textContent = t || ''; m.hidden = !t; }

  // ---------- sound + confetti ----------
  function primeAudio() { try { var C = window.AudioContext || window.webkitAudioContext; if (!C) return; state.audio = state.audio || new C(); state.audio.resume && state.audio.resume(); } catch (e) {} }
  function chime() {
    var a = state.audio; if (!a) return;
    try {
      var now = a.currentTime;
      [[880, 0], [1318.5, 0.13], [1760, 0.26]].forEach(function (n) {
        var o = a.createOscillator(), g = a.createGain();
        o.type = 'sine'; o.frequency.value = n[0];
        g.gain.setValueAtTime(0.0001, now + n[1]);
        g.gain.exponentialRampToValueAtTime(0.25, now + n[1] + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, now + n[1] + 0.7);
        o.connect(g); g.connect(a.destination); o.start(now + n[1]); o.stop(now + n[1] + 0.75);
      });
    } catch (e) {}
  }
  function confetti() {
    var b = $('.mhc-burst'); b.innerHTML = '';
    var cols = ['#cca43b', '#e9cf7a', '#1f7a3d', '#3a2211', '#f3dc8e'];
    for (var i = 0; i < 28; i++) {
      var p = document.createElement('i'), ang = Math.random() * Math.PI * 2, d = 70 + Math.random() * 120;
      p.style.background = cols[i % cols.length];
      p.style.setProperty('--x', Math.cos(ang) * d + 'px');
      p.style.setProperty('--y', Math.sin(ang) * d + 40 + 'px');
      p.style.setProperty('--r', (Math.random() * 540 - 270) + 'deg');
      p.style.animationDelay = (Math.random() * 0.12) + 's';
      b.appendChild(p);
    }
  }

  function success(o) {
    var btn = $('.mhc-submit');
    btn.classList.add('is-done');
    setTimeout(function () {
      state.busy = false;
      btn.classList.remove('is-busy', 'is-done');
      if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
      $('[data-mhc-okno]').innerHTML = 'Order number <b>' + (o.order || '') + '</b>';
      $('[data-mhc-okprod]').textContent = (o.variantTitle || state.variant.title);
      $('[data-mhc-okpay]').textContent = o.mode === 'prepaid' ? 'Paid online · ' + rupee(o.total) : 'Cash on Delivery · ' + rupee(o.total);
      $('[data-mhc-okaddr]').textContent = [F.city.value.trim(), F.pincode.value].filter(Boolean).join(' - ') || '—';
      $('[data-mhc-oknote]').textContent = o.mode === 'prepaid'
        ? 'Payment received. We will pack and ship your order soon.'
        : 'Please keep ' + rupee(o.total) + ' ready at delivery. Our team may call you on +91 ' + fmtPhone(digits(F.phone.value)) + ' to confirm.';
      showView('ok'); confetti(); chime(); vib([30, 50, 30]);
      // after the PayU redirect the browser blocks sound until the first touch: play the chime on that touch
      if (state.audio && state.audio.state !== 'running') {
        var once = function () { ov.removeEventListener('pointerdown', once, true); primeAudio(); setTimeout(chime, 60); };
        ov.addEventListener('pointerdown', once, true);
      }
    }, 260);
    var params = { value: o.total / 100, currency: 'INR', content_ids: [String(o.variantId || state.variant.id)], content_type: 'product', num_items: 1, order_id: o.order };
    if (!o.demo && !o.test) {
      track('Purchase', params, o.eventId);
      gtagEv('purchase', { transaction_id: o.order, value: o.total / 100, currency: 'INR', items: [{ item_id: String(o.variantId || state.variant.id), item_name: D.product, price: o.total / 100, quantity: 1 }] });
      gtagEv('conversion', { send_to: 'AW-18555004443/CmsoCNH23bEdEJvM249F', value: o.total / 100, currency: 'INR', transaction_id: o.order });
    }
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (state.busy) return;
    msg('');
    if (!validate()) return;
    if (form.company_website && form.company_website.value) return;
    primeAudio();
    state.busy = true;
    if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
    var btn = $('.mhc-submit');
    btn.classList.add('is-busy');
    $('[data-mhc-cta]').innerHTML = (state.mode === 'prepaid' ? 'Opening payment' : 'Placing your order') + ' <span class="mhc-dots"><i></i><i></i><i></i></span>';
    vib(15);
    track('AddPaymentInfo', { value: payable() / 100, currency: 'INR', content_ids: [String(state.variant.id)], content_type: 'product' }, 'api_' + state.eid);
    gtagEv('add_payment_info', { currency: 'INR', value: payable() / 100, payment_type: state.mode === 'prepaid' ? 'online' : 'cod' });

    var payload = {
      mode: state.mode, variant_id: state.variant.id, quantity: 1, idem: state.eid,
      name: F.name.value.trim(), phone: digits(F.phone.value), address: F.address.value.trim(), landmark: F.landmark.value.trim(),
      pincode: F.pincode.value, city: F.city.value.trim(), state: sel.value, email: F.email.value.trim(),
      attr: store.get('mh_attr') || {}, page_url: location.href, fbp: cookie('_fbp'), fbc: cookie('_fbc'), ua: navigator.userAgent,
      test_key: TEST_KEY
    };

    if (DEMO) {
      setTimeout(function () {
        var demoNo = '#DEMO-' + Math.floor(1000 + Math.random() * 9000);
        if (state.mode === 'prepaid') { showView('wait'); setTimeout(function () { success({ demo: true, mode: 'prepaid', order: demoNo, total: payable() }); }, 1600); }
        else success({ demo: true, mode: 'cod', order: demoNo, total: payable() });
      }, 1100);
      return;
    }

    var ctl = window.AbortController ? new AbortController() : null;
    var tm = setTimeout(function () { ctl && ctl.abort(); }, 20000);
    fetch(API + (state.mode === 'prepaid' ? '/prepaid/start' : '/cod'), {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), signal: ctl ? ctl.signal : undefined
    }).then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
      .then(function (j) {
        clearTimeout(tm);
        if (!j || !j.ok) throw new Error((j && j.error) || 'Order could not be placed. Please try again.');
        if (state.mode === 'prepaid') return goPayU(j.payu);
        success({ mode: 'cod', order: j.order, total: j.total, eventId: j.event_id, variantId: state.variant.id, variantTitle: j.variant_title, test: !!j.test });
      })
      .catch(function (err) {
        clearTimeout(tm);
        state.busy = false;
        btn.classList.remove('is-busy');
        render();
        msg(err && err.name === 'AbortError' ? 'Network is slow. Please check your internet and tap again.' : (err && err.message ? err.message : 'Network problem. Please try again.'));
        vib([20, 40, 20]);
      });
  });

  function goPayU(p) {
    showView('wait');
    var f = document.createElement('form');
    f.method = 'POST'; f.action = p.action; f.style.display = 'none';
    Object.keys(p.fields).forEach(function (k) { var i = document.createElement('input'); i.type = 'hidden'; i.name = k; i.value = p.fields[k]; f.appendChild(i); });
    document.body.appendChild(f);
    setTimeout(function () { f.submit(); }, 350);
  }

  // ---------- back from PayU ----------
  (function returnFromPayU() {
    var ord = qs.get('mh_order'), paid = qs.get('mh_paid'), fail = qs.get('mh_pay');
    if (!ord && !fail) return;
    var total = Number(qs.get('mh_total') || 0), eid = qs.get('mh_eid'), vId = Number(qs.get('mh_v')) || 0, isT = qs.get('mh_t') === '1';
    var clean = function () { ['mh_order', 'mh_paid', 'mh_pay', 'mh_total', 'mh_eid', 'mh_v', 'mh_t', 'mh_test'].forEach(function (k) { qs.delete(k); }); history.replaceState(null, '', location.pathname + (qs.toString() ? '?' + qs : '') + location.hash); };
    setTimeout(function () {
      clean();
      state.variant = variantById(vId || pageVariantId());
      if (ord && paid === '1') {
        restore(); ov.hidden = false; fit(); void ov.offsetHeight; ov.classList.add('is-open'); document.documentElement.style.overflow = 'hidden'; document.documentElement.classList.add('mhc-on');
        try { history.pushState({ mhc: 1 }, ''); pushed = true; } catch (e) {}
        primeAudio();
        success({ mode: 'prepaid', order: ord, total: total, eventId: eid, variantId: state.variant.id, test: isT });
      } else if (fail) {
        open('prepaid');
        msg('Payment was not completed. Please try again, or choose Cash on Delivery.');
      }
    }, 300);
  })();

  window.MHC = { open: open, close: close };
})();
</script>
