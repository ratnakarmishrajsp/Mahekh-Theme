  .mhc-flag{display:block;width:1.9rem;height:1.3rem;border-radius:2px;background:linear-gradient(#ff9933 0 33.3%,#fff 33.3% 66.6%,#138808 66.6%);box-shadow:0 0 0 1px rgba(0,0,0,.12);position:relative}
  .mhc-flag::after{content:'';position:absolute;left:50%;top:50%;width:.36rem;height:.36rem;margin:-.18rem 0 0 -.18rem;border-radius:50%;border:1px solid #000080}
