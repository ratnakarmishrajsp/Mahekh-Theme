  .mhc-sum>div{display:flex;justify-content:space-between;gap:1rem}
  .mhc-sum__off{color:#1f7a3d;font-weight:600}
  .mhc-free{color:#1f7a3d;font-weight:700}
  .mhc-sum__tot{padding-top:.5rem;border-top:1px solid #eadfc8;font-size:1.5rem;font-weight:700;color:var(--mhc-ink)}

  /* ---------- fixed footer ---------- */
  .mhc-foot{flex:none;padding:1rem 1.6rem calc(.9rem + env(safe-area-inset-bottom));background:var(--mhc-bg);border-top:1px solid #f0e7d6;box-shadow:0 -10px 24px -16px rgba(29,17,7,.35)}
  .mhc-msg{margin:0 0 .8rem;padding:.9rem 1.2rem;border-radius:10px;background:#fdecea;color:#8c1d18;font-size:1.3rem;line-height:1.4}
  .mhc-submit{position:relative;overflow:hidden;width:100%;height:5.6rem;border:0;border-radius:14px;cursor:pointer;background:linear-gradient(135deg,var(--mhc-brown) 0%,var(--mhc-brown2) 100%);color:var(--mhc-gold2);font-family:var(--font-heading-family);font-weight:700;font-size:1.6rem;letter-spacing:.05em;box-shadow:0 12px 26px -12px rgba(29,17,7,.7);transition:transform .15s var(--mhc-ease);-webkit-tap-highlight-color:transparent}
  .mhc-submit:active{transform:scale(.98)}
  .mhc-submit.is-pre{background:linear-gradient(135deg,#f3dc8e 0%,var(--mhc-gold) 55%,#b18a2b 100%);color:var(--mhc-ink)}
  .mhc-submit--light{background:#fff;color:var(--mhc-ink);border:1.5px solid var(--mhc-gold);box-shadow:none;margin-top:1.6rem}
  .mhc-submit__shine{position:absolute;top:-60%;left:-40%;width:30%;height:220%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);transform:rotate(22deg) translateX(-160%);animation:mhcShine 3.6s ease-in-out infinite;pointer-events:none}
  .mhc-submit__txt{position:relative;z-index:1;display:inline-flex;align-items:center;gap:.8rem}
  .mhc-submit__bar{position:absolute;left:0;right:0;bottom:0;height:4px;background:rgba(255,255,255,.12);opacity:0;transition:opacity .2s}
  .mhc-submit__bar i{position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(90deg,var(--mhc-gold),#fff3c4,var(--mhc-gold));border-radius:0 4px 4px 0}
  .mhc-submit.is-busy{pointer-events:none}
  .mhc-submit.is-busy .mhc-submit__bar{opacity:1}
  .mhc-submit.is-busy .mhc-submit__bar i{animation:mhcLoad 2.4s cubic-bezier(.1,.7,.3,1) forwards}
  .mhc-submit.is-done .mhc-submit__bar i{animation:none;width:100%;transition:width .25s ease}
  @keyframes mhcLoad{0%{width:0}60%{width:72%}100%{width:90%}}
  .mhc-dots{display:inline-flex;gap:3px}
